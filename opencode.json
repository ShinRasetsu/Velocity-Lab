{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": ["./.opencode/plugin/audit-gate.ts"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--figma-api-key={env:FIGMA_KEY}", "--stdio"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp"],
      "enabled": true
    }
  },
  "agent": {
    "perfection-auditor": {
      "description": "Perfection auditor for Velocity-Lab HUD — catches stair-step, jank, and obvious UX flaws before they ship",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
